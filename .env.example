# Copy this file to .env and fill in your own values.
# .env is ignored by git — never commit real credentials.

SECRET_KEY=paste-a-generated-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase > Project > Connect > Session pooler
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432

# Email reminders (python manage.py send_reminders)
# Leave EMAIL_BACKEND as console to print emails in the terminal.
# To send real emails, use the SMTP backend and a Gmail App Password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=CyclePrep <your-address@gmail.com>

# Set to True only when the site runs on HTTPS
SECURE_COOKIES=False
